<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_surface_focus" />
            <stroke android:width="2dp" android:color="@color/tile_border_focus" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_surface" />
            <stroke android:width="1dp" android:color="@color/tile_border_normal" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
